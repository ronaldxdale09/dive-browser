<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Claim web links and pages so macOS can offer Dive as the default browser. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Web URL</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>http</string>
        <string>https</string>
      </array>
      <key>LSHandlerRank</key>
      <string>Default</string>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>HTML document</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.html</string>
        <string>public.xhtml</string>
      </array>
    </dict>
  </array>
  <!-- Usage descriptions for every macOS TCC-protected resource a web page can
       reach through Chromium. macOS hard-kills the process (SIGABRT via TCC)
       the instant it touches one of these without a declared string, so every
       capability a browser exposes must be listed here even though the prompt,
       not the string, is what actually gates access. Bluetooth in particular
       is reached by passkeys and security keys during Google/WebAuthn sign-in. -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Sites you visit may use Bluetooth for passkeys, security keys, or Web Bluetooth devices.</string>
  <key>NSBluetoothPeripheralUsageDescription</key>
  <string>Sites you visit may use Bluetooth for passkeys, security keys, or Web Bluetooth devices.</string>
  <key>NSHumanReadableCopyright</key>
  <string>© 2026 Dive contributors. MIT License.</string>
  <key>NSCameraUsageDescription</key>
  <string>Pages you visit may ask to use the camera.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Pages you visit may ask to use the microphone.</string>
  <key>NSLocationUsageDescription</key>
  <string>Pages you visit may ask for your location.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Pages you visit may ask for your location.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Sites and devices you cast to may need to find each other on your local network.</string>
  <key>NSMotionUsageDescription</key>
  <string>Pages you visit may ask to use motion and orientation sensors.</string>
</dict>
</plist>
