{
  "name": "dive-browser",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @dive/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:probes": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "check": "bash scripts/check.sh",
    "release:next": "node scripts/release/resolve-release.mjs",
    "test:runtime": "bash scripts/test-runtime.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
