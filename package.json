{
  "name": "dive-browser",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @dive/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:probes": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "check": "pnpm test:probes && cargo fmt --all -- --check && pnpm typecheck && pnpm lint && pnpm test && pnpm --filter @dive/desktop exec vite build && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "release": "node scripts/release/release.mjs cut",
    "release:check": "node scripts/release/release.mjs check",
    "release:bump": "node scripts/release/release.mjs bump"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
